rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /rooms/{roomId}/{document=**} {
      allow read, write: if true;
    }
    match /verification_otps/{emailDoc} {
      allow read, write: if true;
    }
    match /leaderboard_users/{userId} {
      allow read, write: if true;
    }
  }
}
